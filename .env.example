# Copy this file to .env and fill in the values.
# .env is gitignored — never commit real secrets.

# URL of the Cloudflare Worker that proxies AI requests to Anthropic
# (holds the real API key server-side). See worker/README.md to deploy one.
# Without this set, the AI Estimator / Ajutor / invoice-extraction features
# show a clear "not configured" error instead of silently failing.
VITE_AI_PROXY_URL=
